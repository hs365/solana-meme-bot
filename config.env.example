# ============================================================
# Solana Meme Coin Trading Bot - 环境配置示例
# ============================================================
# 复制此文件为 config.env，填写你的真实配置
# cp config.env.example config.env
# ============================================================

# ---------- Solana 网络配置 ----------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# 推荐使用 QuickNode 或 Alchemy 提供的 RPC，速度更快
# SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# ---------- 钱包配置（仅实盘模式需要） ----------
# ⚠️ 安全警告：切勿使用主钱包私钥！请使用专用小钱包！
# 填入 Base58 编码的私钥
BOT_WALLET_KEY=your_wallet_private_key_base58_here

# ---------- 交易参数 ----------
# 单笔买入金额（单位：SOL）
INVEST_AMOUNT_SOL=0.01

# 止损比例（百分比，0-100）
STOP_LOSS_PCT=30

# 多层止盈目标（百分比）
TAKE_PROFIT_1_PCT=50
TAKE_PROFIT_2_PCT=100
TAKE_PROFIT_3_PCT=200

# 成交量触发阈值（单位：SOL）
# 当某币种在短时间内成交量超过此值时触发买入
VOLUME_THRESHOLD_SOL=50

# 最小流动性门槛（单位：SOL）
# 低于此流动性的币种将被过滤，避免被恶意砸盘
MIN_LIQUIDITY_SOL=1000

# ---------- 运行模式 ----------
# true = 模拟盘（不真实下单），false = 实盘
DRY_RUN=true

# ---------- Telegram 通知配置 ----------
# 创建 Bot：https://t.me/BotFather 获取 Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 获取 Chat ID：https://t.me/useridbot 或 @getidsbot
TELEGRAM_CHAT_ID=your_chat_id_here

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
# 可选值：DEBUG, INFO, WARNING, ERROR
LOG_FILE=bot.log

# ---------- pump.fun API ----------
# pump.fun GraphQL API 端点
PUMP_FUN_GRAPHQL_URL=https://graphql.pump.fun/graphql

# ---------- 高级配置 ----------
# 监控轮询间隔（秒）
POLLING_INTERVAL_SECONDS=5

# 最大同时持仓数量
MAX_CONCURRENT_POSITIONS=5

# 是否启用流动性过滤
ENABLE_LIQUIDITY_FILTER=true

# 紧急止损：跌幅达到此值立即全部平仓（不等待下一档）
EMERGENCY_STOP_LOSS_PCT=50
